# ISOKOHUB Enterprise Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ============================================
# MONGODB - REPLICA SET REQUIRED FOR TRANSACTIONS
# ============================================
MONGODB_URI=mongodb://localhost:27017/isokohub
MONGODB_REPLICA_SET=rs0
MONGODB_USER=
MONGODB_PASS=

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=change_this_to_a_random_64_char_secret_key
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_secret_key
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# ============================================
# ENCRYPTION (for sensitive data at rest)
# ============================================
ENCRYPTION_KEY=32_byte_hex_string_for_aes_256_encryption

# ============================================
# CLOUDINARY - MEDIA STORAGE
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# STRIPE PAYMENT GATEWAY
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# PAYPAL PAYMENT GATEWAY
# ============================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ============================================
# MTN MOBILE MONEY API
# ============================================
MTN_API_KEY=your_mtn_api_key
MTN_API_SECRET=your_mtn_api_secret
MTN_COLLECTION_PRIMARY_KEY=your_mtn_collection_key
MTN_COLLECTION_USER_ID=your_mtn_user_id
MTN_ENVIRONMENT=sandbox

# ============================================
# AIRTEL MONEY API
# ============================================
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_SECRET=your_airtel_api_secret
AIRTEL_ENVIRONMENT=sandbox

# ============================================
# EMAIL CONFIGURATION (Nodemailer)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@isokohub.com
EMAIL_FROM_NAME=ISOKOHUB

# ============================================
# SMS CONFIGURATION (Twilio / Africa's Talking)
# ============================================
SMS_PROVIDER=africastalking
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=ISOKOHUB
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# SOCKET.IO & REAL-TIME
# ============================================
SOCKET_CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379

# ============================================
# MULTI-TENANT CONFIG
# ============================================
TENANT_DB_PREFIX=isokohub_tenant_
DEFAULT_TENANT_PLAN=basic
MAX_VENDORS_BASIC=10
MAX_VENDORS_PROFESSIONAL=50
MAX_VENDORS_ENTERPRISE=999999

# ============================================
# CURRENCY & TAX CONFIG
# ============================================
DEFAULT_CURRENCY=RWF
SUPPORTED_CURRENCIES=RWF,USD,EUR,GBP
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key
DEFAULT_TAX_PERCENTAGE=18
DEFAULT_COUNTRY=RW

# ============================================
# PLATFORM COMMISSION
# ============================================
PLATFORM_COMMISSION_PERCENT=5
PLATFORM_WALLET_ADDRESS=isokohub_platform_wallet

# ============================================
# AI & RECOMMENDATION ENGINE
# ============================================
AI_MODEL_ENDPOINT=http://localhost:8000
AI_API_KEY=your_ai_api_key
RECOMMENDATION_CACHE_TTL=3600

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log

# ============================================
# DELIVERY & GPS
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_key
DEFAULT_DELIVERY_RADIUS_KM=50
DELIVERY_BASE_FEE=2000
DELIVERY_PER_KM_FEE=500

# ============================================
# SEARCH & DISCOVERY ENGINE (Elasticsearch / OpenSearch)
# ============================================
# Compatible with Elasticsearch >= 7.x and OpenSearch >= 2.x
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
SEARCH_INDEX_PREFIX=isokohub_
SEARCH_AUTOCOMPLETE_MAX=10
SEARCH_TRENDING_PERIOD=daily
SEARCH_FUZZY_ENABLED=true
SEARCH_FUZZY_THRESHOLD=0.75
SEARCH_CACHE_TTL=300
SEARCH_ANALYTICS_TTL_DAYS=90
SEARCH_HISTORY_TTL_DAYS=90

# ============================================
# CACHE & SESSION
# ============================================
SESSION_SECRET=your_session_secret_key_here
CACHE_TTL=300
